 def runCoreM (p : ProofSnapshot) (t : CoreM α) : IO (α × ProofSnapshot) := do
-  let (a, coreState) ← (Lean.Core.CoreM.toIO · p.coreContext p.coreState) do t
+  let (a, coreState) ← (Lean.Core.CoreM.toIO · p.coreContext p.coreState) do
+    try t
